local function getTargetCFrame(instance)
    if not instance then return nil end
    if instance:IsA("Model") then
        if instance.PrimaryPart then return instance.PrimaryPart.CFrame end
        local part = instance:FindFirstChildWhichIsA("BasePart")
        if part then return part.CFrame end
        return instance:GetPivot()
    elseif instance:IsA("BasePart") then
        return instance.CFrame
    end
    return nil
end

local function executeInstantTeleport(targetCFrame)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp and targetCFrame then
        -- Offsets the character 3 studs high vertically on arrival for physical drop safety
        hrp.CFrame = targetCFrame * CFrame.new(0, 3, 0)
    end
end

