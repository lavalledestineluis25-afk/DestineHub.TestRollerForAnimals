-- Creates or cleans up the custom screen render components for active objects
local function updateEggESP(eggInstance)
    if not eggInstance:IsDescendantOf(workspace) then
        if ActiveEggESPs[eggInstance] then
            ActiveEggESPs[eggInstance]:Destroy()
            ActiveEggESPs[eggInstance] = nil
        end
        return
    end

    -- Scraping instance metadata attributes from the properties layout context [image_gqIUqb.png]
    local zoneAttr = eggInstance:GetAttribute("Zone") or "Unknown"
    local rarityAttr = eggInstance:GetAttribute("Rarity") or "Common"
    local animalAttr = eggInstance:GetAttribute("Animal") or "Egg"
    local sizeAttr = eggInstance:GetAttribute("Size") or 1

    -- Core Filter validation checks
    local shouldShow = false
    if VisualConfig.EspAllNames or VisualConfig.EspSize or VisualConfig.EspDistance then
        if VisualConfig.OnEggFilter then
            if rarityAttr == VisualConfig.EggFilter then
                shouldShow = true
            end
        else
            shouldShow = true
        end
    end

    if not shouldShow then
        if ActiveEggESPs[eggInstance] then
            ActiveEggESPs[eggInstance].Enabled = false
        end
        return
    end

    -- Create or fetch existing BillboardGui container wrapper elements
    local bbg = ActiveEggESPs[eggInstance]
    if not bbg then
        bbg = Instance.new("BillboardGui")
        bbg.Size = UDim2.new(0, 200, 0, 100)
        bbg.AlwaysOnTop = true
        bbg.MaxDistance = 1500
        
        local wrapperFrame = Instance.new("Frame")
        wrapperFrame.Size = UDim2.new(1, 0, 1, 0)
        wrapperFrame.BackgroundTransparency = 1
        wrapperFrame.Name = "Wrapper"
        
        local layout = Instance.new("UIListLayout")
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 2)
        layout.Parent = wrapperFrame
        
        wrapperFrame.Parent = bbg
        ActiveEggESPs[eggInstance] = bbg
    end

    local wrapper = bbg:FindFirstChild("Wrapper")
    if not wrapper then return end
    wrapper:ClearAllChildren()
    
    local layout = Instance.new("UIListLayout")
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 2)
    layout.Parent = wrapper

    local txtColor = RarityColors[rarityAttr] or Color3.fromRGB(255, 255, 255)
    local targetPart = eggInstance:IsA("BasePart") and eggInstance or eggInstance.PrimaryPart or eggInstance:FindFirstChildWhichIsA("BasePart")
    
    if not targetPart then return end
    bbg.Adornee = targetPart

    -- Text Line Generation Core: Component stack
    if VisualConfig.EspAllNames then
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Text = string.format("[%s] %s (%s)", zoneAttr, animalAttr, rarityAttr)
        nameLabel.Size = UDim2.new(0, 200, 0, 14)
        nameLabel.TextColor3 = txtColor
        nameLabel.TextStrokeTransparency = 0
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.SourceSansBold
        nameLabel.TextSize = 13
        nameLabel.LayoutOrder = 1
        nameLabel.Parent = wrapper
    end

    if VisualConfig.EspSize then
        local sizeLabel = Instance.new("TextLabel")
        sizeLabel.Text = string.format("Size: %.2f", tonumber(sizeAttr) or 1)
        sizeLabel.Size = UDim2.new(0, 200, 0, 12)
        sizeLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
        sizeLabel.TextStrokeTransparency = 0
        sizeLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.SourceSans
        sizeLabel.TextSize = 11
        sizeLabel.LayoutOrder = 2
        sizeLabel.Parent = wrapper
    end

    if VisualConfig.EspDistance then
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local distance = hrp and (hrp.Position - targetPart.Position).Magnitude or 0
        
        local distLabel = Instance.new("TextLabel")
        distLabel.Text = string.format("%d studs", math.floor(distance))
        distLabel.Size = UDim2.new(0, 200, 0, 12)
        distLabel.TextColor3 = Color3.fromRGB(200, 250, 255)
        distLabel.TextStrokeTransparency = 0
        distLabel.BackgroundTransparency = 1
        distLabel.Font = Enum.Font.SourceSansItalic
        distLabel.TextSize = 11
        distLabel.LayoutOrder = 3
        distLabel.Parent = wrapper
    end

    bbg.Enabled = true
    -- Parent to safe execution Core UI space context bounds container vectors
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui and bbg.Parent ~= playerGui then
        bbg.Parent = playerGui
    end
end

-- Track player entities to construct real-time bounded bounding boxes
local function updatePlayerESP(player)
    if player == LocalPlayer then return end
    
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local head = character and character:FindFirstChild("Head")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if not character or not hrp or not head or not humanoid or humanoid.Health <= 0 then
        if ActivePlayerESPs[player] then
            ActivePlayerESPs[player].NameGui:Destroy()
            ActivePlayerESPs[player].BoxGui:Destroy()
            ActivePlayerESPs[player] = nil
        end
        return
    end

    local espData = ActivePlayerESPs[player]
    if not espData then
        local nameGui = Instance.new("BillboardGui")
        nameGui.Size = UDim2.new(0, 150, 0, 30)
        nameGui.AlwaysOnTop = true
        nameGui.MaxDistance = 2000
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = 14
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.Parent = nameGui

        local boxGui = Instance.new("BillboardGui")
        boxGui.AlwaysOnTop = true
        boxGui.MaxDistance = 2000
        
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5
        stroke.Color = Color3.fromRGB(255, 50, 50)
        
        local boxFrame = Instance.new("Frame")
        boxFrame.Size = UDim2.new(1, 0, 1, 0)
        boxFrame.BackgroundTransparency = 1
        stroke.Parent = boxFrame
        boxFrame.Parent = boxGui

        espData = { NameGui = nameGui, BoxGui = boxGui, Label = label }
        ActivePlayerESPs[player] = espData
    end

    -- Update Name UI
    espData.NameGui.Adornee = head
    espData.NameGui.StudsOffset = Vector3.new(0, 2, 0)
    espData.Label.Text = player.DisplayName or player.Name
    espData.NameGui.Enabled = VisualConfig.EspPlayerName
    
    -- Calculate precise scale sizing bounds matched to character configuration height models vectors
    espData.BoxGui.Adornee = hrp
    espData.BoxGui.Size = UDim2.new(0, 45, 0, 65)
    espData.BoxGui.Enabled = VisualConfig.EspPlayerBox

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        if espData.NameGui.Parent ~= playerGui then espData.NameGui.Parent = playerGui end
        if espData.BoxGui.Parent ~= playerGui then espData.BoxGui.Parent = playerGui end
    end
end

