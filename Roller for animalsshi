-- ENVIRONMENT MODIFIERS ENGINE (FPS Booster & Dynamic Material X-Ray Core)
-- ============================================================================
local XrayOriginalTransparencies = {}

local function ApplyXray(state)
    if state then
        -- Iterate map space and push translucency to all walls and structural terrain parts
        for _, instance in ipairs(workspace:GetDescendants()) do
            if instance:IsA("BasePart") and not instance:IsDescendantOf(LocalPlayer.Character) then
                -- Safely cache current original transparency configuration mapping bounds
                if not XrayOriginalTransparencies[instance] then
                    XrayOriginalTransparencies[instance] = instance.Transparency
                end
                instance.Transparency = 0.65 -- Transparent window look frame settings
            end
        end
    else
        -- Cleanly restore cached material depth visuals
        for instance, originalValue in pairs(XrayOriginalTransparencies) do
            if instance and instance.Parent then
                instance.Transparency = originalValue
            end
        end
        table.clear(XrayOriginalTransparencies)
    end
end

-- Monitor newly streamed objects to apply X-Ray state on the fly if toggled
workspace.DescendantAdded:Connect(function(descendant)
    if PlayerConfig.Xray and descendant:IsA("BasePart") and not descendant:IsDescendantOf(LocalPlayer.Character) then
        XrayOriginalTransparencies[descendant] = descendant.Transparency
        descendant.Transparency = 0.65
    end
end)

local function ApplyFpsBooster(state)
    if state then
        -- Throttles global game workspace particle engine processing rates context
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Sparkles") or obj:IsA("Smoke") or obj:IsA("Fire") then
                obj.Enabled = false
            elseif obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                obj.Material = Enum.Material.SmoothPlastic
            end
        end
    else
        -- Standard defaults fallback restore triggers
        settings().Rendering.QualityLevel = Enum.QualityLevel.Default
        Lighting.GlobalShadows = true
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Sparkles") or obj:IsA("Smoke") or obj:IsA("Fire") then
                obj.Enabled = true
            elseif obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                obj.Material = Enum.Material.Plastic -- Standard restoration fallback
            end
        end
    end
end

