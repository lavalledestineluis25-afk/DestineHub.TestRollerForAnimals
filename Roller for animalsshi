local Config = {
    AutoCollect = false,
    Method = "Tweenservice",
    FarmDelay = 0.5,
    TweenSpeed = 150,
    MeadowRarities = {} 
}

local RarityList = { 
    "Common", 
    "Uncommon", 
    "Rare", 
    "Epic", 
    "Legendary", 
    "Mythic", 
    "Admin", 
    "Celestial", 
    "Eternal", 
    "Ascended", 
    "Exclusive" 
}

local TweenService = game:GetService("TweenService")
