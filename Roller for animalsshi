RunService.PostSimulation:Connect(function()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then
        -- Enforces custom speed changes immediately if active
        if PlayerConfig.WalkSpeedToggle then
            humanoid.WalkSpeed = PlayerConfig.WalkSpeedValue
        end
        
        -- Enforces custom jump limits instantly if active
        if PlayerConfig.JumpPowerToggle then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = PlayerConfig.JumpPowerValue
        end
    end
    
    -- Noclip Operational Sequence (Bypasses collision parameters across parts)
    if PlayerConfig.Noclip and character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Infinite Jump Core Physics Connection Handler
UserInputService.JumpRequest:Connect(function()
    if PlayerConfig.InfiniteJump then
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

